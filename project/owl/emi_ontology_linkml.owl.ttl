@prefix PATO: <http://purl.obolibrary.org/obo/PATO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix emi_ontology_linkml: <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

emi_ontology_linkml:PersonCollection a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PersonCollection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty emi_ontology_linkml:entries ],
        [ a owl:Restriction ;
            owl:allValuesFrom emi_ontology_linkml:Person ;
            owl:onProperty emi_ontology_linkml:entries ] ;
    skos:definition "A holder for Person objects" ;
    skos:inScheme <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml> .

emi_ontology_linkml:NamedThing a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "NamedThing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty emi_ontology_linkml:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty emi_ontology_linkml:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty emi_ontology_linkml:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty emi_ontology_linkml:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty emi_ontology_linkml:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty emi_ontology_linkml:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty emi_ontology_linkml:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty emi_ontology_linkml:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty emi_ontology_linkml:name ] ;
    skos:definition "A generic grouping for any identifiable entity" ;
    skos:exactMatch schema1:Thing ;
    skos:inScheme <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml> .

emi_ontology_linkml:Person a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty emi_ontology_linkml:birth_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom emi_ontology_linkml:PersonStatus ;
            owl:onProperty emi_ontology_linkml:vital_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty emi_ontology_linkml:age_in_years ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Date ;
            owl:onProperty emi_ontology_linkml:birth_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^\\S+@[\\S+\\.]+\\S+" ] ) ] ;
            owl:onProperty emi_ontology_linkml:primary_email ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty emi_ontology_linkml:vital_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty emi_ontology_linkml:primary_email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty emi_ontology_linkml:age_in_years ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Integer ;
            owl:onProperty emi_ontology_linkml:age_in_years ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty emi_ontology_linkml:birth_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty emi_ontology_linkml:primary_email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty emi_ontology_linkml:vital_status ],
        emi_ontology_linkml:NamedThing ;
    skos:definition "Represents a Person" ;
    skos:inScheme <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml> .

PATO:0001421 a owl:Class,
        emi_ontology_linkml:PersonStatus ;
    rdfs:label "ALIVE" ;
    rdfs:subClassOf emi_ontology_linkml:PersonStatus .

PATO:0001422 a owl:Class,
        emi_ontology_linkml:PersonStatus ;
    rdfs:label "DEAD" ;
    rdfs:subClassOf emi_ontology_linkml:PersonStatus .

<https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml/PersonStatus#UNKNOWN> a owl:Class,
        emi_ontology_linkml:PersonStatus ;
    rdfs:label "UNKNOWN" ;
    rdfs:subClassOf emi_ontology_linkml:PersonStatus .

emi_ontology_linkml:entries a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "entries" ;
    skos:inScheme <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml> .

emi_ontology_linkml:age_in_years a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "age_in_years" ;
    rdfs:range linkml:Integer ;
    skos:definition "Number of years since birth" ;
    skos:inScheme <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml> .

emi_ontology_linkml:birth_date a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "birth_date" ;
    rdfs:range linkml:Date ;
    skos:definition "Date on which a person is born" ;
    skos:inScheme <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml> .

emi_ontology_linkml:description a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "description" ;
    skos:definition "A human-readable description for a thing" ;
    skos:inScheme <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml> .

emi_ontology_linkml:id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "id" ;
    rdfs:range linkml:Uriorcurie ;
    skos:definition "A unique identifier for a thing" ;
    skos:inScheme <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml> .

emi_ontology_linkml:name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "name" ;
    skos:definition "A human-readable name for a thing" ;
    skos:inScheme <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml> .

emi_ontology_linkml:primary_email a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "primary_email" ;
    skos:definition "The main email address of a person" ;
    skos:inScheme <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml> .

emi_ontology_linkml:vital_status a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "vital_status" ;
    rdfs:range emi_ontology_linkml:PersonStatus ;
    skos:definition "living or dead status" ;
    skos:inScheme <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml> .

emi_ontology_linkml:PersonStatus a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( PATO:0001421 PATO:0001422 <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml/PersonStatus#UNKNOWN> ) ;
    linkml:permissible_values PATO:0001421,
        PATO:0001422,
        <https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml/PersonStatus#UNKNOWN> .

<https://w3id.org/earth-metabolome-initiative/emi-ontology-linkml> a owl:Ontology ;
    rdfs:label "emi-ontology-linkml" ;
    dcterms:license "MIT" ;
    dcterms:title "emi-ontology-linkml" ;
    rdfs:seeAlso <https://earth-metabolome-initiative.github.io/emi-ontology-linkml> ;
    skos:definition "Testing LinkML to manage the EMI Ontology" .

